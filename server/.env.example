PORT=5000
MONGODB_URL=mongodb://127.0.0.1:27017/safeher
JWT_SECRET=change-me-to-a-long-random-string

# Frontend address(es) allowed to call the API, comma separated
CLIENT_URL=http://localhost:5173
# Base URL used in live-tracking links sent to contacts (defaults to the first CLIENT_URL)
# PUBLIC_APP_URL=https://safeher.vercel.app

# Set to 1 when deployed behind a proxy (Render, Railway, Nginx) so rate limits see real IPs
# TRUST_PROXY=1

# ---- SOS alerts via Twilio (optional) ----
# Without these, alerts are printed in the server console and the app
# offers "send from my phone" (WhatsApp / SMS app) instead.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# SOS_CHANNELS=sms
# TWILIO_SMS_FROM=+1XXXXXXXXXX
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
DEFAULT_COUNTRY_CODE=+91

# ---- Map services (optional; free public servers are used by default) ----
# OSRM_FOOT_URL=https://routing.openstreetmap.de/routed-foot
# OSRM_DRIVING_URL=https://router.project-osrm.org
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# SAFETY_TIMEZONE=Asia/Kolkata
